@using InfoID.LicenseManager.Web.ViewModels.Plans
@model PlanFormViewModel
@{
    ViewData["Title"] = "Edit plan";
}
<a asp-action="Index" class="back-link">@Html.Icon("arrow-left", "sm") All plans</a>
<div class="page-head">
    <div class="titles">
        <h1>Edit plan</h1>
        <p class="lead">Changes reach every customer the next time they open the Editions page.</p>
    </div>
</div>
<form asp-action="Edit" asp-route-id="@ViewData["PlanId"]" method="post" class="stack" novalidate>
    <partial name="_PlanFields" model="Model" />
    <div class="form-foot">
        <button type="submit" class="btn primary">Save plan</button>
        <a asp-action="Index" class="btn ghost">Cancel</a>
    </div>
</form>
