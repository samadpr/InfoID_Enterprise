@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p class="lead muted">InfoID staff only.</p>
<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert error"></div>
    <div class="mb">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="mb">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <button type="submit" class="btn primary block">Sign in</button>
</form>
