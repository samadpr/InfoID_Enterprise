       Depends on nothing but the BCL and the shared licensing protocol library
       (activation code / serial key / signed token formats), which is itself BCL-only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\InfoID.Licensing.Core\InfoID.Licensing.Core.csproj" />
  </ItemGroup>
</Project>
