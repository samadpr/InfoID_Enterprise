<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:InfoID.Desktop.Features.Templates.ViewModels"
             xmlns:models="using:InfoID.Desktop.Features.Templates.Models"
             xmlns:core="using:InfoID.Desktop.Core.Models"
             xmlns:components="using:InfoID.Desktop.Shell.Components"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="820"
             x:Class="InfoID.Desktop.Features.Templates.Views.TemplatesView"
             x:DataType="vm:TemplatesViewModel"
             Background="{DynamicResource BrushBackground}">

    <DockPanel Margin="40,28,40,0">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <components:PageHeaderView Grid.Column="0" Title="New card from template" BackCommand="{Binding GoBackCommand}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Bottom">
                <StackPanel Spacing="4" Width="140">
                    <TextBlock Text="Orientation" Classes="label" />
                    <ComboBox ItemsSource="{Binding OrientationOptions}"
                              SelectedItem="{Binding SelectedOrientationOption}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="4" Width="140">
                    <TextBlock Text="Format" Classes="label" />
                    <ComboBox ItemsSource="{Binding FormatOptions}"
                              SelectedItem="{Binding SelectedFormatOption}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Filter by category" Classes="label" Margin="0,0,0,10" />

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding CategoryChips}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:FilterChipOption">
                    <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                  Margin="0,0,8,8" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FilteredTemplates}" Margin="0,0,0,32">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <Border Classes="tile" Width="230" Height="200" Margin="0,0,16,16">
                            <Button Command="{Binding $parent[UserControl].DataContext.UseTemplateCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Padding="16"
                                    HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="100" CornerRadius="{StaticResource Radius.MD}"
                                            Background="{Binding AccentBrush}">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                                   FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" />
                                    </Border>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0" Spacing="4">
                                        <TextBlock Text="{Binding Name}" Classes="body" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" Classes="caption" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
