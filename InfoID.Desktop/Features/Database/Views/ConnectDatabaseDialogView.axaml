<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoID.Desktop.Features.Database.ViewModels"
             x:Class="InfoID.Desktop.Features.Database.Views.ConnectDatabaseDialogView"
             x:DataType="vm:ConnectDatabaseDialogViewModel"
             Background="{DynamicResource BrushSurface}">

	<StackPanel Width="420"
                Margin="24"
                Spacing="18">

		<TextBlock Text="Connect to database"
                   Classes="h2" />

		<TextBlock Text="Choose a database type to connect."
                   Classes="body"
                   TextWrapping="Wrap" />

		<Button Content="SQLite"
                HorizontalAlignment="Stretch" />

		<StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">

			<Button Content="Cancel"
                    Command="{Binding CancelCommand}" />

			<Button Classes="primary"
                    Content="Connect"
                    Command="{Binding ConnectCommand}" />

		</StackPanel>

	</StackPanel>

</UserControl>