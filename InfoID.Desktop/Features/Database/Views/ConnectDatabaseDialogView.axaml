<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoID.Desktop.Features.Database.ViewModels"
             x:Class="InfoID.Desktop.Features.Database.Views.ConnectDatabaseDialogView"
             x:DataType="vm:ConnectDatabaseDialogViewModel">

    <Grid Width="500"
          Height="650"
          Margin="24"
          RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="16"
                        Margin="0,0,0,10">

                <TextBlock Text="Connect to database"
                           Classes="h2" />

                <TextBlock Text="Connect an Excel file using ODBC."
                           TextWrapping="Wrap" />

                <!-- Connection Name -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Connection name" />

                    <TextBox Text="{Binding ConnectionName}"
                             Watermark="e.g. Excel Database" />
                </StackPanel>

                <!-- Database Type -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Database type" />

                    <ComboBox SelectedItem="{Binding SelectedDatabaseType}"
                              ItemsSource="{Binding DatabaseTypes}" />
                </StackPanel>

                <!-- Excel File -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Excel file" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <TextBox Text="{Binding FilePath}"
                                 Watermark="Select an Excel file..."
                                 Width="380" />

                        <Button Content="Browse"
                                Command="{Binding BrowseExcelFileCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Connection String -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Connection string" />

                    <TextBox Text="{Binding ConnectionString}"
                             Watermark="Enter connection string"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80" />
                </StackPanel>

                <!-- Test Connection -->
                <Button Content="Test Connection"
                        HorizontalAlignment="Left"
                        Command="{Binding TestConnectionCommand}" />

                <!-- Excel Sheet -->
                <StackPanel Spacing="6">

                    <TextBlock Text="Excel sheet" />

                    <ComboBox ItemsSource="{Binding Sheets}"
                              SelectedItem="{Binding SelectedSheet}"
                              PlaceholderText="Select a sheet..." />

                    <Button Content="Read Sheet"
                            HorizontalAlignment="Left"
                            Command="{Binding ReadSelectedSheetCommand}" />
                </StackPanel>

                <!-- Data -->
                <DataGrid x:Name="ExcelPreviewGrid"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                Height="220"
                Margin="0,10,0,0" />

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />

            </StackPanel>

        </ScrollViewer>

        <!-- Fixed buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">

            <Button Content="Cancel"
                    Command="{Binding CancelCommand}" />

            <Button Content="Connect"
                    Command="{Binding ConnectCommand}" />

        </StackPanel>

    </Grid>

</UserControl>
