<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoID.Desktop.Features.Database.ViewModels"
             xmlns:models="using:InfoID.Desktop.Features.Database.Models"
             x:Class="InfoID.Desktop.Features.Database.Views.DatabaseTypeSelectionDialogView"
             x:DataType="vm:DatabaseTypeSelectionDialogViewModel"
            xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Grid Width="1000"
        Height="700"
        Background="{DynamicResource BrushBackground}"
        RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">

            <UniformGrid Columns="4"
                         Margin="48"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top">

                <!--   Database -->
                <Button Classes="databaseCard"
                        Command="{Binding SelectDatabaseCommand}"
                        CommandParameter="{x:Static models:DatabaseType.SampleDatabase}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="Database"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="Sample Database (SQLite)"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- Internal Database -->
                <Button Classes="databaseCard"
                    Command="{Binding SelectDatabaseCommand}"
                    CommandParameter="{x:Static models:DatabaseType.InternalDatabase}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="DatabaseCog"
                 Width="52"
                 Height="52"
                 Foreground="{DynamicResource BrushPrimary}"
                 HorizontalAlignment="Center" />

                        <TextBlock Text="Internal Database (SQLite)"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- Visitors (Visitor Management) -->
                <Button Classes="databaseCard"
                        Command="{Binding SelectDatabaseCommand}"
                        CommandParameter="{x:Static models:DatabaseType.Visitors}"
                        ToolTip.Tip="Visitor registrations from the Visitors page: use these fields to design the visitor badge">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <mi:MaterialIcon Kind="BadgeAccountHorizontalOutline"
                                         Width="52"
                                         Height="52"
                                         Foreground="{DynamicResource BrushPrimary}"
                                         HorizontalAlignment="Center" />
                        <TextBlock Text="Visitors"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Excel -->
                <Button Classes="databaseCard"
                        Command="{Binding SelectDatabaseCommand}"
                        CommandParameter="{x:Static models:DatabaseType.Excel}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="FileExcel"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="Excel"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>


                <!-- Access -->
                <Button
                    Classes="databaseCard"
                    Command="{Binding SelectDatabaseCommand}"
                    CommandParameter="{x:Static models:DatabaseType.Access}">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">

                        <mi:MaterialIcon Kind="DatabaseCog"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Microsoft Access"
                            FontSize="12"
                            HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>
                <!-- CSV/TXT -->
                <Button Classes="databaseCard"
                 Command="{Binding SelectDatabaseCommand}"
                 CommandParameter="{x:Static models:DatabaseType.CSV}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="FileDelimited"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="CSV/TXT"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>

                

                <!-- SQLite -->
                <Button Classes="databaseCard"
                        Command="{Binding SelectDatabaseCommand}"
                        CommandParameter="{x:Static models:DatabaseType.SQLite}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="Database"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="SQLite"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- MySQL -->
                <Button
      Classes="databaseCard"
      Command="{Binding SelectDatabaseCommand}"
      CommandParameter="{x:Static models:DatabaseType.MySQL}">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">

                        <mi:MaterialIcon Kind="Database"
                 Width="52"
                 Height="52"
                 Foreground="{DynamicResource BrushPrimary}"
                 HorizontalAlignment="Center" />

                        <TextBlock
                            Text="MySQL"
                            FontSize="12"
                            HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- PostgreSQL -->
                <Button Classes="databaseCard"
                        Command="{Binding SelectDatabaseCommand}"
                        CommandParameter="{x:Static models:DatabaseType.PostgreSQL}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="Database"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="PostgreSQL"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- ODBC -->
                <Button Classes="databaseCard"
                        Command="{Binding SelectDatabaseCommand}"
                        CommandParameter="{x:Static models:DatabaseType.ODBC}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="DatabaseSync"
                 Width="52"
                 Height="52"
                 Foreground="{DynamicResource BrushPrimary}"
                 HorizontalAlignment="Center" />

                        <TextBlock Text="ODBC"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>
                <!-- SQL Server -->
                <Button Classes="databaseCard"
                        Command="{Binding SelectDatabaseCommand}"
                        CommandParameter="{x:Static models:DatabaseType.SQLServer}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="Server"
                 Width="52"
                 Height="52"
                 Foreground="{DynamicResource BrushPrimary}"
                 HorizontalAlignment="Center" />

                        <TextBlock Text="SQL Server"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>

                <!-- Active Directory -->
                <!--<Button Classes="databaseCard">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="AccountGroup"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="Active Directory"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>-->

                <!-- Google Sheets -->
                <Button Classes="databaseCard"
                    Command="{Binding SelectDatabaseCommand}"
                  CommandParameter="{x:Static models:DatabaseType.GoogleSheets}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="Table"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="Google Sheets"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>


                <Button Classes="databaseCard"
        Command="{Binding SelectDatabaseCommand}"
        CommandParameter="{x:Static models:DatabaseType.API}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">

                        <mi:MaterialIcon Kind="Api"
                  Width="52"
                  Height="52"
                  Foreground="{DynamicResource BrushPrimary}"
                  HorizontalAlignment="Center" />

                        <TextBlock Text="API"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </Button>
            </UniformGrid>

        </ScrollViewer>

        <!-- Cancel -->
        <Button Grid.Row="1"  Classes="cancelButton" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right"
                Margin="24" Padding="32,12" />

    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.cancelButton">

            <Setter Property="Foreground"
                    Value="{DynamicResource BrushPrimary}" />

            <Setter Property="Background"
                    Value="{DynamicResource BrushCardBackground}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushPrimary}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="20" />

        </Style>

        <Style Selector="Button.cancelButton:pointerover">

            <Setter Property="Foreground"
                    Value="{DynamicResource BrushPrimaryForeground}" />

            <Setter Property="Background"
                    Value="{DynamicResource BrushPrimary}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushPrimary}" />

        </Style>
        <!-- Normal database card -->
        <!-- Database cards -->
        <Style Selector="Button.databaseCard">

            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="190" />
            <Setter Property="Margin" Value="5" />

            <Setter Property="Background"
                    Value="{DynamicResource BrushCardBackground}" />

            <Setter Property="Foreground"
                    Value="{DynamicResource BrushTextPrimary}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushBorder}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="{StaticResource Radius.LG}" />

            <Setter Property="Padding"
                    Value="16" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Transitions">
                <Transitions>

                    <BrushTransition
                        Property="Background"
                        Duration="0:0:0.12" />

                    <BrushTransition
                        Property="BorderBrush"
                        Duration="0:0:0.12" />

                </Transitions>
            </Setter>

        </Style>


        <!-- Database card hover -->
        <Style Selector="Button.databaseCard:pointerover">

            <Setter Property="Background"
                    Value="{DynamicResource BrushSurfaceElevated}" />

            <Setter Property="Foreground"
                    Value="{DynamicResource BrushTextPrimary}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushPrimary}" />

        </Style>


        <!-- Database card pressed -->
        <Style Selector="Button.databaseCard:pressed">

            <Setter Property="Background"
                    Value="{DynamicResource BrushSelectionBackground}" />

            <Setter Property="Foreground"
                    Value="{DynamicResource BrushTextPrimary}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BrushPrimaryPressed}" />

        </Style>
    </UserControl.Styles>

</UserControl>
