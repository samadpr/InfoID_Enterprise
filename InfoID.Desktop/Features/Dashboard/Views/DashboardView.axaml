<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:InfoID.Desktop.Features.Dashboard.ViewModels"
             xmlns:history="using:InfoID.Desktop.Features.PrintHistory.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="900"
             x:Class="InfoID.Desktop.Features.Dashboard.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:Name="Root"
             Background="{DynamicResource BrushBackground}">

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.metric">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Width" Value="232" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.metricLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="mi|MaterialIcon.metricIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>
        <Style Selector="TextBlock.attention">
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="CornerRadius" Value="3,3,0,0" />
        </Style>
        <Style Selector="Border.bar.today">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.bar:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.shortcut">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.activity">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel MaxWidth="1320" Margin="40,28,40,40" Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard" Classes="h1" />
                    <TextBlock Classes="caption" Foreground="{DynamicResource BrushTextSecondary}">
                        <Run Text="{Binding Greeting}" /><Run Text=" · " /><Run Text="{Binding TodayText}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" Classes="caption" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,4,0" />
                    <Button Classes="secondary" Command="{Binding RefreshCommand}" HotKey="F5"
                            ToolTip.Tip="Refresh (F5). The dashboard also refreshes every minute."
                            AutomationProperties.Name="Refresh dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" ToolTip.Tip="Choose which sections to show"
                            AutomationProperties.Name="Customize dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="TuneVariant" Width="16" Height="16" />
                            <TextBlock Text="Customize" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" Margin="4" MinWidth="220">
                                    <TextBlock Text="Show on dashboard" FontWeight="SemiBold" />
                                    <CheckBox Content="Key figures" IsChecked="{Binding ShowMetrics}" />
                                    <CheckBox Content="Cards per day" IsChecked="{Binding ShowTrend}" />
                                    <CheckBox Content="Expiring cards" IsChecked="{Binding ShowExpiring}" />
                                    <CheckBox Content="Recent activity" IsChecked="{Binding ShowRecent}" />
                                    <CheckBox Content="System health" IsChecked="{Binding ShowHealth}" />
                                    <CheckBox Content="Shortcuts" IsChecked="{Binding ShowShortcuts}" />
                                    <Button Classes="ghost" Content="Show all" Command="{Binding ShowAllWidgetsCommand}"
                                            HorizontalAlignment="Left" Padding="0,4" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />

            <Border Background="#1AD13438" BorderBrush="#66D13438" BorderThickness="1" CornerRadius="6" Padding="12,10"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrushError}" />
            </Border>

            <!-- Key figures (FR-DSH-1) -->
            <WrapPanel IsVisible="{Binding ShowMetrics}" Margin="0,0,-16,-16">
                <Border Classes="metric">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Classes="metricIcon" Kind="CardAccountDetailsOutline" />
                            <TextBlock Classes="metricLabel" Text="Cards printed today" />
                        </StackPanel>
                        <TextBlock Classes="metricValue" Text="{Binding CardsToday, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="caption" Text="{Binding CardsTodayDetail}" Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>
                <Border Classes="metric">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Classes="metricIcon" Kind="CalendarMonthOutline" />
                            <TextBlock Classes="metricLabel" Text="Cards this month" />
                        </StackPanel>
                        <TextBlock Classes="metricValue" Text="{Binding CardsThisMonth, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="caption" Text="{Binding CardsThisMonthDetail}" Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>
                <Border Classes="metric">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Classes="metricIcon" Kind="Replay" />
                            <TextBlock Classes="metricLabel" Text="Reprints this month" />
                        </StackPanel>
                        <TextBlock Classes="metricValue" Text="{Binding ReprintsThisMonth, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="caption" Foreground="{DynamicResource BrushTextSecondary}"
                                   Text="{Binding FailedRunsThisMonth, StringFormat='{}{0:N0} failed print run(s)'}" />
                    </StackPanel>
                </Border>
                <Border Classes="metric" ToolTip.Tip="Issued cards whose expiry date is within the next 30 days">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Classes="metricIcon" Kind="CalendarAlert" />
                            <TextBlock Classes="metricLabel" Text="Expiring in 30 days" />
                        </StackPanel>
                        <TextBlock Classes="metricValue" Classes.attention="{Binding HasExpiring}"
                                   Text="{Binding ExpiringSoonCount, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="caption" Foreground="{DynamicResource BrushTextSecondary}"
                                   Text="{Binding ExpiredCount, StringFormat='{}{0:N0} already expired, still in use'}" />
                    </StackPanel>
                </Border>
                <Border Classes="metric" ToolTip.Tip="People with an issued card (from designs with a Person ID column)">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Classes="metricIcon" Kind="AccountMultipleOutline" />
                            <TextBlock Classes="metricLabel" Text="People with cards" />
                        </StackPanel>
                        <TextBlock Classes="metricValue" Text="{Binding PeopleWithCards, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="caption" Text="Holding a current card" Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </Border>
                <Button Classes="ghost" Padding="0" Margin="0" Command="{Binding OpenLicenseCommand}"
                        ToolTip.Tip="Open License" AutomationProperties.Name="License status">
                    <Border Classes="metric" Width="300">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Classes="metricIcon" Kind="ShieldCheckOutline" />
                                <TextBlock Classes="metricLabel" Text="License" />
                            </StackPanel>
                            <TextBlock Text="{Binding LicenseTitle}" FontSize="18" FontWeight="SemiBold"
                                       Classes.attention="{Binding LicenseNeedsAttention}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{Binding LicenseUsagePercent}" Maximum="100" Height="6"
                                         IsVisible="{Binding HasCardLimit}" />
                            <TextBlock Classes="caption" Text="{Binding LicenseUsageText}" Foreground="{DynamicResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Button>
            </WrapPanel>

            <!-- Trend + expiring -->
            <UniformGrid Rows="1" IsVisible="{Binding ShowMiddleRow}" Margin="0,0,-16,0">
                <Border Classes="panel" IsVisible="{Binding ShowTrend}" Margin="0,0,16,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
                            <TextBlock Classes="panelTitle" Text="Cards per day" />
                            <TextBlock Classes="caption" Text="{Binding TrendSummary}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DailyBars}" Height="150" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DailyBar">
                                    <Grid RowDefinitions="*,Auto,Auto" Margin="3,0" ToolTip.Tip="{Binding Tooltip}">
                                        <Border Grid.Row="0" Classes="bar" Classes.today="{Binding IsToday}"
                                                Height="{Binding BarHeight}" VerticalAlignment="Bottom" MaxWidth="28" />
                                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BrushBorder}" />
                                        <TextBlock Grid.Row="2" Text="{Binding DayLabel}" FontSize="10" Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Classes="panel" IsVisible="{Binding ShowExpiring}" Margin="0,0,16,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Classes="panelTitle" Text="{Binding ExpiringHeader}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" Content="View report" Command="{Binding OpenExpiringReportCommand}"
                                    ToolTip.Tip="Open the Expiring cards report (export to Excel or PDF)" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Classes="caption" Text="{Binding ExpiringMoreText}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   IsVisible="{Binding ExpiringMoreText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Panel>
                            <TextBlock Text="No cards expire in the next 30 days." Classes="caption" IsVisible="{Binding !HasExpiring}"
                                       Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ExpiringCards}" IsVisible="{Binding HasExpiring}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExpiringRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Classes="caption" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding DaysText}" FontWeight="Medium" HorizontalAlignment="Right"
                                                           Classes.attention="{Binding IsUrgent}" />
                                                <TextBlock Text="{Binding ExpiryText}" Classes="caption" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Recent activity (FR-DSH-3) + system health (FR-DSH-5) -->
            <UniformGrid Rows="1" IsVisible="{Binding ShowBottomRow}" Margin="0,0,-16,0">
                <Border Classes="panel" IsVisible="{Binding ShowRecent}" Margin="0,0,16,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Classes="panelTitle" Text="Recent print activity" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" Content="View all" Command="{Binding OpenPrintHistoryCommand}" />
                        </Grid>
                        <Panel>
                            <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasRecent}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Text="Nothing printed yet. Print runs appear here as soon as you print from the Card Designer." />
                            <ItemsControl ItemsSource="{Binding RecentJobs}" IsVisible="{Binding HasRecent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="history:PrintJobRow">
                                        <Button Classes="activity" ToolTip.Tip="Open in Print history"
                                                Command="{Binding #Root.((vm:DashboardViewModel)DataContext).OpenJobCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <mi:MaterialIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DesignName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="caption" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding WhenText}" /><Run Text=" · " /><Run Text="{Binding PrinterName}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                    <TextBlock HorizontalAlignment="Right" FontWeight="Medium"
                                                               Text="{Binding TotalCards, StringFormat='{}{0:N0} card(s)'}" />
                                                    <TextBlock HorizontalAlignment="Right" Classes="caption" Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource BrushSuccess}" IsVisible="{Binding !IsFailed}" />
                                                    <TextBlock HorizontalAlignment="Right" Classes="caption" Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource BrushError}" IsVisible="{Binding IsFailed}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </DockPanel>
                </Border>

                <Border Classes="panel" IsVisible="{Binding ShowHealth}" Margin="0,0,16,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="panelTitle" Text="System health" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Health}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HealthItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6">
                                        <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,12,0">
                                            <mi:MaterialIcon Kind="CheckCircleOutline" Foreground="{DynamicResource BrushSuccess}" IsVisible="{Binding IsOk}" />
                                            <mi:MaterialIcon Kind="AlertCircleOutline" Foreground="{DynamicResource BrushWarning}" IsVisible="{Binding IsWarning}" />
                                            <mi:MaterialIcon Kind="CloseCircleOutline" Foreground="{DynamicResource BrushError}" IsVisible="{Binding IsError}" />
                                        </Panel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" Classes="caption" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Shortcuts (FR-DSH-2) -->
            <StackPanel Spacing="12" IsVisible="{Binding ShowShortcuts}">
                <TextBlock Classes="panelTitle" Text="Shortcuts" />
                <WrapPanel>
                    <Button Classes="shortcut secondary" Command="{Binding NewCardCommand}" ToolTip.Tip="Start a new card design (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="PlusBoxOutline" Width="20" Height="20" />
                            <TextBlock Text="New card" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="shortcut secondary" Command="{Binding OpenTemplatesCommand}" ToolTip.Tip="Open a design or start from a template">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20" />
                            <TextBlock Text="Open / templates" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="shortcut secondary" Command="{Binding OpenRecentDesignsCommand}" ToolTip.Tip="Designs you worked on recently">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="20" Height="20" />
                            <TextBlock Text="Recent designs" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="shortcut secondary" Command="{Binding OpenPrintHistoryCommand}" ToolTip.Tip="Every print run and card">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="History" Width="20" Height="20" />
                            <TextBlock Text="Print history" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="shortcut secondary" Command="{Binding OpenReportsCommand}" ToolTip.Tip="Issuance, print log, expiring and replacement cards">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="FileChartOutline" Width="20" Height="20" />
                            <TextBlock Text="Reports" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="shortcut secondary" Command="{Binding OpenAuditLogCommand}" ToolTip.Tip="Who did what and when, with integrity check">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="ShieldSearch" Width="20" Height="20" />
                            <TextBlock Text="Audit log" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="shortcut secondary" Command="{Binding OpenBackupCommand}" ToolTip.Tip="Back up InfoID's data or restore a backup">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="BackupRestore" Width="20" Height="20" />
                            <TextBlock Text="Backup &amp; Restore" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="shortcut secondary" Command="{Binding OpenLicenseCommand}" ToolTip.Tip="License and account">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20" />
                            <TextBlock Text="License" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
