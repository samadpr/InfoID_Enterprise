<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:InfoID.Desktop.Features.Welcome.ViewModels"
             xmlns:models="using:InfoID.Desktop.Features.Welcome.Models"
             xmlns:icons="using:InfoID.Desktop.Features.CardDesigner.Views.Icons"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="820"
             x:Class="InfoID.Desktop.Features.Welcome.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel"
             x:Name="Root"
             Background="{DynamicResource BrushBackground}">

    <ScrollViewer>
        <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Margin="40,32,40,48" Spacing="40">

            <!-- Hero -->
            <Border Classes="heroSurface" MinHeight="220">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#DA3025" Offset="0" />
                        <GradientStop Color="#7A1710" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="48,0" ColumnDefinitions="260,*" ColumnSpacing="36">
					<Border Grid.Column="0"
                            Width="220"
                            Height="220"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="24"
                            Padding="25">

						<Image Source="avares://InfoID.Desktop/Assets/Images/InfoIDLogo.png"
							   Stretch="Uniform"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />
					</Border>

					<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12" MaxWidth="640">
                        <TextBlock Text="Welcome to InfoID" Classes="display" Foreground="White" />
                        <TextBlock Text="Design, manage and print professional ID cards for your organization -- fully offline, enterprise-ready."
                                   Foreground="#F3E7E6" FontSize="15" TextWrapping="Wrap" />
                        <Button Classes="secondary" Content="Create New Card" Margin="0,12,0,0"
                                Command="{Binding CreateBlankCardCommand}"
                                Foreground="White" BorderBrush="White" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recent cards -->
            <StackPanel Spacing="16">
                <TextBlock Text="Recent cards" Classes="h2" />

                <WrapPanel>

                    <Border Classes="tile" Width="220" Height="180" Padding="20" Margin="0,0,16,16">
                        <StackPanel VerticalAlignment="Center" Spacing="12">
                            <Button Classes="primary" Content="Blank card &gt;" HorizontalAlignment="Stretch"
                                    Command="{Binding CreateBlankCardCommand}" />
                            <Button Classes="secondary" Content="Use template &gt;" HorizontalAlignment="Stretch"
                                    Command="{Binding UseTemplateCommand}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding RecentCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:RecentCardItem">
								<Button Classes="tile" Width="220" Height="180" Padding="16" Margin="0,0,16,16"
										HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
										Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).OpenRecentCommand}"
										CommandParameter="{Binding}">
									<!-- Right-click actions (Part: "enterprise level" recent-card
										 management): Open mirrors the button's own click, Pin/Unpin
										 and Delete both go through RecentCardListViewModelBase so
										 Home and the full Recent Designs page behave identically. -->
									<Button.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Open"
													  Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).OpenRecentCommand}"
													  CommandParameter="{Binding}" />
											<MenuItem Header="Unpin" IsVisible="{Binding IsPinned}"
													  Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).TogglePinRecentCommand}"
													  CommandParameter="{Binding}" />
											<MenuItem Header="Pin" IsVisible="{Binding !IsPinned}"
													  Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).TogglePinRecentCommand}"
													  CommandParameter="{Binding}" />
											<Separator />
											<MenuItem Header="Delete"
													  Command="{Binding #Root.((vm:WelcomeViewModel)DataContext).DeleteRecentCommand}"
													  CommandParameter="{Binding}" />
										</ContextMenu>
									</Button.ContextMenu>
									<StackPanel Spacing="8">
										<!-- Real thumbnail when one exists (Part 61); a plain neutral
											 tile otherwise : never a fake/generic "card" picture, just
											 an honest empty state until the design has actually been
											 saved at least once.

											 Priority 1 fix: pinned status used to be a separate "Pinned"
											 text row below the subtitle, which added height the fixed-
											 size tile didn't have and clipped the name/metadata. It is
											 now a small red pin badge overlaid on the top-right corner
											 of the thumbnail instead, so the tile's text layout never
											 changes based on pinned state. -->
										<Panel Height="96">
											<Border CornerRadius="6" Background="{DynamicResource BrushBackground}"
													ClipToBounds="True">
												<Image Source="{Binding ThumbnailImage}" Stretch="Uniform" />
											</Border>
											<Border IsVisible="{Binding IsPinned}"
													Width="22" Height="22" CornerRadius="11"
													Background="#DA3025"
													HorizontalAlignment="Right" VerticalAlignment="Top"
													Margin="0,-6,-6,0"
													ToolTip.Tip="Pinned"
													BoxShadow="0 1 3 0 #40000000">
												<PathIcon Data="{x:Static icons:DesignerIcons.Pin}"
														  Width="12" Height="12" Foreground="White" />
											</Border>
										</Panel>
										<TextBlock Text="{Binding Name}" Classes="h3" TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</Button>
							</DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="tile" Width="220" Height="180" Margin="0,0,16,16" IsVisible="{Binding !HasRecentCards}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="No recent cards yet" Classes="bodySecondary" HorizontalAlignment="Center" />
                            <TextBlock Text="Your recently opened cards will appear here" Classes="caption"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="160" />
                        </StackPanel>
                    </Border>

                    <!-- "View More" (Part: full Recent Designs page) : only shown once
                         there are actually more recent items than fit in this preview
                         row, so it never appears as a dead-looking tile with nothing
                         more to show. -->
                    <Button Classes="tile ghost" Width="220" Height="180" Margin="0,0,16,16"
                            IsVisible="{Binding HasMoreRecentCards}"
                            Command="{Binding ViewMoreRecentCommand}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="View More" Classes="h3" HorizontalAlignment="Center" />
                            <TextBlock Text="See every recent design and file" Classes="caption"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="160" />
                        </StackPanel>
                    </Button>

                </WrapPanel>
            </StackPanel>

            <!-- Go further -->
            <StackPanel Spacing="16">
                <TextBlock Text="Go further" Classes="h2" />

                <WrapPanel>
                    <Border Classes="tile" Width="260" Height="120" Padding="20" Margin="0,0,16,16">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Templates" Classes="h3" />
                            <TextBlock Text="Browse ready-made designs by industry" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tile" Width="260" Height="120" Padding="20" Margin="0,0,16,16">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Cardholders" Classes="h3" />
                            <TextBlock Text="Manage the people cards are issued to" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tile" Width="260" Height="120" Padding="20" Margin="0,0,16,16">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Printing" Classes="h3" />
                            <TextBlock Text="Single, batch and reprint workflows" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tile" Width="260" Height="120" Padding="20" Margin="0,0,16,16">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Learning" Classes="h3" />
                            <TextBlock Text="Guides and tips to get the most out of InfoID" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
