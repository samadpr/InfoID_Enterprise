<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:InfoID.Desktop.Features.CardDesigner.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="820"
             x:Class="InfoID.Desktop.Features.CardDesigner.Views.CardDesignerView"
             x:DataType="vm:CardDesignerViewModel"
             Background="{DynamicResource BrushBackground}">

    <DockPanel>

        <!-- Document tab strip placeholder - future multi-document workspace will
             replace this single-tab bar with a real TabControl bound to open documents. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,8">
                <Button Grid.Column="0" Classes="ghost" Content="&lt; Back to selection" Command="{Binding GoBackCommand}" />
                <Border Grid.Column="1" Background="{DynamicResource BrushSelectionBackground}"
                        CornerRadius="{StaticResource Radius.SM}" Padding="12,6" HorizontalAlignment="Left" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Title}" Classes="body" FontWeight="Medium" />
                </Border>
                <Button Grid.Column="2" Classes="secondary" Content="Home" Command="{Binding GoHomeCommand}" />
            </Grid>
        </Border>

        <!-- Reserved future toolbar row: Selection / Pan / Zoom / Text / Shape / Image /
             Barcode / QR / Signature / Fingerprint / Background / Database Field /
             Alignment / Grid / Guides / Layers / Print / Save -->
        <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="Designer toolbar -- coming soon" Classes="caption" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="56,*,260">

            <!-- Reserved future left tool rail: Text / Shape / Image / Barcode / QR /
                 Signature / Fingerprint / Background / Database field -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" />

            <!-- Canvas placeholder -->
            <Grid Grid.Column="1">
                <Border Width="428" Height="270" CornerRadius="{StaticResource Radius.LG}"
                        Background="{DynamicResource BrushCardBackground}"
                        BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="24">
                        <TextBlock Text="Card design canvas" Classes="h3" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SourceDescription}" Classes="bodySecondary" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SizeDescription}" Classes="caption" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding OrientationDescription}" Classes="caption" HorizontalAlignment="Center" />
                        <TextBlock Text="The full design canvas, layers and tools arrive in a later phase."
                                   Classes="caption" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Reserved future right properties panel -->
            <Border Grid.Column="2" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,0">
                <StackPanel Margin="16" Spacing="8">
                    <TextBlock Text="Properties" Classes="h3" />
                    <TextBlock Text="Element and document properties will appear here."
                               Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
