<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:InfoID.Desktop.Features.CardDesigner.ViewModels"
             xmlns:doc="using:InfoID.Desktop.Features.CardDesigner.Models.Document"
             xmlns:controls="using:InfoID.Desktop.Features.CardDesigner.Views.Controls"
             xmlns:conv="using:InfoID.Desktop.Features.CardDesigner.Converters"
             xmlns:icons="using:InfoID.Desktop.Features.CardDesigner.Views.Icons"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:services="using:InfoID.Desktop.Features.CardDesigner.Services"
             xmlns:printing="using:InfoID.Desktop.Features.Printing.Views"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="820"
             x:Class="InfoID.Desktop.Features.CardDesigner.Views.CardDesignerView"
             x:DataType="vm:CardDesignerViewModel"
             x:Name="Root"
             Background="{DynamicResource BrushBackground}">

	<UserControl.Styles>

		<!-- Compact, icon-button-like sizing shared by every toolbar/tool-rail button. -->
        <!-- Toolbar buttons (Oct 2026 redesign): ONE style for every toolbar button.
             Neutral grey icon; hover = subtle surface; on/checked = teal tint + teal icon;
             disabled = faded, never a grey box. -->
        <Style Selector="Button.toolbtn, ToggleButton.toolbtn">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="ToggleButton.toolbtn.compact">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Text segments (Front | Back | Both) and labelled toolbar buttons. -->
        <Style Selector="Button.toolbtn-wide, ToggleButton.toolbtn-wide">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Order matters: hover first, then checked, so a checked button keeps its tint. -->
        <Style Selector="Button.toolbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.toolbtn-wide:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolbtn-wide:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.toolbtn:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolbtn-wide:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushSelectionBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
        </Style>
        <Style Selector="ToggleButton.toolbtn:checked PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
        </Style>
        <Style Selector="Button.toolbtn:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolbtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.toolbtn:disabled, ToggleButton.toolbtn:disabled">
            <Setter Property="Opacity" Value="0.38" />
        </Style>

        <!-- Segmented group: tools, card side, zoom. -->
        <Style Selector="Border.segment">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Thin vertical separator between toolbar groups. -->
        <Style Selector="Border.tbsep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
        </Style>

        <!-- Properties panel fields (Oct 2026): label inside the box, unit on the right,
             no spinner buttons (arrow keys and mouse wheel still step the value). -->
        <Style Selector="NumericUpDown.prop">
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.propPrefix">
            <Setter Property="Margin" Value="10,0,2,0" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>
        <Style Selector="TextBlock.propUnit">
            <Setter Property="Margin" Value="2,0,10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>
        <Style Selector="TextBlock.propSection">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        </Style>

        <!-- Design check pill: neutral when clean, amber when it found issues. -->
        <Style Selector="Button.checkchip">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.checkchip.warn">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
        </Style>

		<!-- Left icon rail (Part 10): compact square icon buttons, one per insertable
             element type plus the Shapes flyout. Taller than the top-toolbar toolbtn so
             the rail reads as a distinct vertical strip of "tools" rather than a second
             copy of the top toolbar. -->
		<Style Selector="Button.railbtn, ToggleButton.railbtn">
			<Setter Property="Width" Value="40" />
			<Setter Property="Height" Value="38" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
		</Style>
		<Style Selector="Button.railbtn:pointerover /template/ ContentPresenter, ToggleButton.railbtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BrushHoverOverlay}" />
		</Style>
		<Style Selector="ToggleButton.railbtn:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BrushSelectionBackground}" />
		</Style>
		<Style Selector="ToggleButton.railbtn:checked PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
		</Style>

		<!-- Layers panel row (Part 96): the drag handle/lock/visibility/delete action
             group only appears on hover, same "don't clutter the row until it's
             relevant" idea the rest of this app already follows; and the whole row
             tints when its element(s) are part of the current selection, matching the
             tab strip's own Classes.active pattern (AppHeaderView) rather than a
             one-off style just for this panel. -->
		<Style Selector="Border.layerRow">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Border.layerRow.selected">
			<Setter Property="Background" Value="{DynamicResource BrushSelectionBackground}" />
		</Style>
		<Style Selector="Border.layerRow StackPanel.layerRowActions">
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="Border.layerRow:pointerover StackPanel.layerRowActions">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<!-- Drag feedback (Part 96 follow-up: drag felt "not smooth" with zero visual
             cue): the row being lifted goes translucent, and whichever row the pointer
             is currently over while dragging gets an accent outline so a drop target is
             obvious before you let go, not just after. -->
		<Style Selector="Border.layerRow.dragging">
			<Setter Property="Opacity" Value="0.45" />
		</Style>
		<Style Selector="Border.layerRow.dragOver">
			<Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
			<Setter Property="BorderThickness" Value="1.5" />
		</Style>
		<Style Selector="Border.layerRow">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="PathIcon.layerChevron">
			<Setter Property="RenderTransform" Value="rotate(0deg)" />
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="PathIcon.layerChevron.expanded">
			<Setter Property="RenderTransform" Value="rotate(90deg)" />
		</Style>

		<!-- Small caret badge on the Shapes rail button, hinting it opens a flyout
             rather than inserting a single fixed shape (Part 12). -->
		<Style Selector="Path.flyoutCaret">
			<Setter Property="Fill" Value="{DynamicResource BrushTextSecondary}" />
			<Setter Property="Data" Value="M0,0 L5,0 L2.5,3 Z" />
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Bottom" />
			<Setter Property="Margin" Value="0,0,3,3" />
		</Style>

		<!-- One square button inside the Shapes flyout grid -->
		<Style Selector="Button.shapeoption">
			<Setter Property="Width" Value="52" />
			<Setter Property="Height" Value="52" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.shapeoption:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BrushHoverOverlay}" />
		</Style>

		<!-- Same tile, but a ToggleButton: used where the "shapeoption" look needs a
             persistent checked state (e.g. the Image Properties Clipping tab's mask
             shape picker), which a plain Button has no concept of. ToggleButton does
             not inherit from Button in Avalonia (both derive from ButtonBase
             separately), so the Button-scoped style above does not apply to it; this
             is a deliberate parallel rule, not a duplicate by oversight. -->
		<Style Selector="ToggleButton.shapeoption">
			<Setter Property="Width" Value="52" />
			<Setter Property="Height" Value="52" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="ToggleButton.shapeoption:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BrushHoverOverlay}" />
		</Style>
		<Style Selector="ToggleButton.shapeoption:checked">
			<Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
		</Style>
		<Style Selector="ToggleButton.shapeoption:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BrushSelectionBackground}" />
		</Style>

		<!-- Horizontal "icon + label" row button, used by the Add Image flyout
             (Priority 12: Browse Image / Take Photo) — same visual language as
             .shapeoption/.railbtn (transparent, hover highlight, rounded corners) but
             a full-width row instead of a square icon tile, since these two options
             need a text label alongside the icon to read as two distinct actions
             rather than two unlabeled pictures. -->
		<Style Selector="Button.menuoption">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Padding" Value="8,7" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
		</Style>
		<Style Selector="Button.menuoption:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BrushHoverOverlay}" />
		</Style>

        <!-- Database area action buttons (Add database / Apply / Disconnect):
             clear hover and pressed feedback, with a smooth fade. -->
        <!-- Data grid: a typed value that doesn't fit its field (number, date...) -->
        <Style Selector="TextBox.cellError /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushError}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.cellError:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushError}" />
        </Style>

        <Style Selector="Button.dbAction">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.dbAction /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dbAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3300A878" />
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.dbAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#4D00A878" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- In case the theme underlines the button text itself on hover -->
        <Style Selector="Button.dbAction TextBlock, Button.dbAction:pointerover TextBlock">
            <Setter Property="TextDecorations" Value="{x:Null}" />
        </Style>

        <Style Selector="TabControl.propTabs">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl.propTabs TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        
	</UserControl.Styles>

	<UserControl.DataTemplates>

		<!-- IMPORTANT: these two DataTemplates are intentionally UNKEYED (no x:Key)
             and live under DataTemplates (not Resources) - in Avalonia, Resources is
             a strict key/value dictionary and cannot hold Style or unkeyed DataTemplate
             objects at all (unlike WPF). DataTemplates is the dedicated collection
             Avalonia uses for implicit, type-matched content templating: it auto-selects
             a template for a bare ContentControl by matching DataType against the
             content's runtime type. That's what makes
             Content="{Binding ActiveTab.PrimarySelection}" automatically show the right
             editor for whatever element type is selected. -->
		<!--<DataTemplate DataType="doc:TextElement">
			<StackPanel Spacing="10">
				<TextBlock Text="Text content" Classes="caption" />
				<TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60"
                         Watermark="Type the text shown on the card..." />

				--><!-- Font family (Part 16): real installed-font picker instead of typing
                     a name. IsEditable so a font saved from another machine (not
                     installed here) still shows/keeps its name instead of the ComboBox
                     just going blank: "handle unavailable fonts gracefully".
                     FontFamilyNamesWithRecentFirst puts whatever's been used recently
                     (RecentFontsTracker, updated from TextElement/DataFieldElement's own
                     OnFontFamilyChanged) at the top of the list. The ItemTemplate below
                     renders each entry IN that font's own typeface (Avalonia's
                     FontFamily type accepts a plain string directly, same as the raw
                     string CardCanvasView already hands to Typeface's own constructor),
                     so a name like "Wingdings 3" actually looks like Wingdings 3 in the
                     dropdown instead of every entry looking identical in the UI font. --><!--
				<StackPanel Spacing="4">
					<TextBlock Text="Font family" Classes="caption" />
					<ComboBox ItemsSource="{x:Static services:SystemFontCatalog.FontFamilyNamesWithRecentFirst}"
                              Text="{Binding FontFamily, Mode=TwoWay}"
                              IsEditable="True" IsTextSearchEnabled="True" HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" FontFamily="{Binding Converter={x:Static conv:StringToFontFamilyConverter.Instance}}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>

				<Grid ColumnDefinitions="*,*">
					<StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
						<TextBlock Text="Font size" Classes="caption" />
						<NumericUpDown Value="{Binding FontSize, Mode=TwoWay}" Minimum="4" Maximum="200" Increment="1" />
					</StackPanel>
					<StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
						<TextBlock Text="Color" Classes="caption" />
						<controls:ColorPickerField ColorHex="{Binding ColorHex, Mode=TwoWay}" />
					</StackPanel>
				</Grid>
				<StackPanel Orientation="Horizontal" Spacing="12">
					<CheckBox Content="Bold" IsChecked="{Binding Bold, Mode=TwoWay}" />
					<CheckBox Content="Italic" IsChecked="{Binding Italic, Mode=TwoWay}" />
					<CheckBox Content="Underline" IsChecked="{Binding Underline, Mode=TwoWay}" />
				</StackPanel>

				--><!-- Text alignment (paragraph alignment inside this text box) — deliberately
                     a separate control from the "Align" buttons in the main toolbar, which move
                     the OBJECT itself relative to other objects/the card (Part 1). Mixing the
                     two under one ambiguous "Align" label was the original bug report. --><!--
				<TextBlock Text="Text alignment" Classes="caption" Margin="0,4,0,0" />
				<StackPanel Orientation="Horizontal" Spacing="4">
					<ToggleButton Classes="toolbtn" Content="&#8676;" ToolTip.Tip="Text align left"
                                  IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Left}" />
					<ToggleButton Classes="toolbtn" Content="&#8596;" ToolTip.Tip="Text align center"
                                  IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Center}" />
					<ToggleButton Classes="toolbtn" Content="&#8677;" ToolTip.Tip="Text align right"
                                  IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Right}" />
					<ToggleButton Classes="toolbtn" Content="&#8801;" ToolTip.Tip="Text justify"
                                  IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Justify}" />
				</StackPanel>
				<TextBlock Text="Vertical alignment" Classes="caption" Margin="0,4,0,0" />
				<StackPanel Orientation="Horizontal" Spacing="4">
					<ToggleButton Classes="toolbtn" Content="&#8613;" ToolTip.Tip="Vertical align top"
                                  IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Top}" />
					<ToggleButton Classes="toolbtn" Content="&#8597;" ToolTip.Tip="Vertical align middle"
                                  IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Middle}" />
					<ToggleButton Classes="toolbtn" Content="&#8615;" ToolTip.Tip="Vertical align bottom"
                                  IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Bottom}" />
				</StackPanel>
                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="Database Fields"
                               Classes="caption" />

                    <TextBlock Text="{Binding DatabaseColumn,
                              StringFormat='Connected field: {0}'}"
                               FontSize="13"
                               Opacity="0.7" />

                    <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.ActiveTab.DatabaseFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ColumnName}"
                                        Command="{Binding #Root.((vm:CardDesignerViewModel)DataContext).ActiveTab.AddDatabaseFieldCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2"
                                        Padding="8,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
				--><!-- Data binding (Part 24/42/43). Leave empty for ordinary static text.
                     When set, the "Text content" box above is ignored while designing —
                     the canvas shows this expression itself, and (with Data Preview on)
                     the evaluated value against the selected sample record. --><!--
				
				--><!-- Conditional visibility (Part 25/44). Leave empty to always show.
                     Only evaluated with Data Preview on — otherwise every element stays
                     visible so a conditional element doesn't just vanish while designing. --><!--
				<TextBlock Text="Visibility condition" Classes="caption" Margin="0,4,0,0" />
				<TextBox Text="{Binding VisibilityCondition, Mode=TwoWay}" Watermark="e.g. Department == 'Security'" />
			</StackPanel>
		</DataTemplate>-->
        <DataTemplate DataType="doc:TextElement">

            <TabControl>

                <!-- ========================================================= -->
                <!-- STYLE TAB                                                  -->
                <!-- ========================================================= -->

                <TabItem Header="Style">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Spacing="10" Margin="0,8,0,20">
                            <!-- ALIGNMENT: horizontal + vertical side by side -->
                            <TextBlock Text="ALIGNMENT" Classes="propSection" Margin="0,6,0,0" />
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                                <Border Grid.Column="0" Classes="segment">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align text left" AutomationProperties.Name="Align text left"
                                                      IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Left}">
                                            <mi:MaterialIcon Kind="FormatAlignLeft" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Centre text" AutomationProperties.Name="Centre text"
                                                      IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Center}">
                                            <mi:MaterialIcon Kind="FormatAlignCenter" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align text right" AutomationProperties.Name="Align text right"
                                                      IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Right}">
                                            <mi:MaterialIcon Kind="FormatAlignRight" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Justify" AutomationProperties.Name="Justify"
                                                      IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Justify}">
                                            <mi:MaterialIcon Kind="FormatAlignJustify" Width="16" Height="16" />
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="segment">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Text at the top of the box" AutomationProperties.Name="Vertical align top"
                                                      IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Top}">
                                            <mi:MaterialIcon Kind="FormatVerticalAlignTop" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Text in the middle of the box" AutomationProperties.Name="Vertical align middle"
                                                      IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Middle}">
                                            <mi:MaterialIcon Kind="FormatVerticalAlignCenter" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Text at the bottom of the box" AutomationProperties.Name="Vertical align bottom"
                                                      IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Bottom}">
                                            <mi:MaterialIcon Kind="FormatVerticalAlignBottom" Width="16" Height="16" />
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                            </Grid>
                           

                            <!-- FONT -->
                            <TextBlock Text="FONT" Classes="propSection" Margin="0,6,0,0" />
                            <ComboBox ItemsSource="{x:Static services:SystemFontCatalog.FontFamilyNamesWithRecentFirst}"
                                      Text="{Binding FontFamily, Mode=TwoWay}"
                                      IsEditable="True" IsTextSearchEnabled="True" HorizontalAlignment="Stretch"
                                      Height="32" CornerRadius="8" AutomationProperties.Name="Font family">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding Converter={x:Static conv:StringToFontFamilyConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Size + colour on one row -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <NumericUpDown Grid.Column="0" Classes="prop" Value="{Binding FontSize, Mode=TwoWay}"
                                               Minimum="4" Maximum="200" Increment="1" FormatString="0.#"
                                               ToolTip.Tip="Font size (arrow keys or mouse wheel to adjust)" AutomationProperties.Name="Font size">
                                    <NumericUpDown.InnerLeftContent>
                                        <mi:MaterialIcon Kind="FormatSize" Width="15" Height="15" Margin="10,0,2,0"
                                                         Foreground="{DynamicResource BrushTextSecondary}" />
                                    </NumericUpDown.InnerLeftContent>
                                </NumericUpDown>
                                <controls:ColorPickerField Grid.Column="1" VerticalAlignment="Center"
                                                           ColorHex="{Binding ColorHex, Mode=TwoWay}"
                                                           ToolTip.Tip="Text colour" />
                            </Grid>

                            <!-- Bold / Italic / Underline as one segmented group -->
                            <Border Classes="segment" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <ToggleButton Classes="toolbtn" IsChecked="{Binding Bold, Mode=TwoWay}"
                                                  ToolTip.Tip="Bold" AutomationProperties.Name="Bold">
                                        <mi:MaterialIcon Kind="FormatBold" Width="18" Height="18" />
                                    </ToggleButton>
                                    <ToggleButton Classes="toolbtn" IsChecked="{Binding Italic, Mode=TwoWay}"
                                                  ToolTip.Tip="Italic" AutomationProperties.Name="Italic">
                                        <mi:MaterialIcon Kind="FormatItalic" Width="18" Height="18" />
                                    </ToggleButton>
                                    <ToggleButton Classes="toolbtn" IsChecked="{Binding Underline, Mode=TwoWay}"
                                                  ToolTip.Tip="Underline" AutomationProperties.Name="Underline">
                                        <mi:MaterialIcon Kind="FormatUnderline" Width="18" Height="18" />
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <!-- TEXT -->
                            <TextBlock Text="TEXT" Classes="propSection" />
                            <TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="64" MaxHeight="80" CornerRadius="8"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Watermark="Type the text shown on the card..."
                                     AutomationProperties.Name="Text content" />

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>


                <!-- ========================================================= -->
                <!-- PARAMETERS TAB                                             -->
                <!-- ========================================================= -->

                <TabItem Header="Parameters">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Spacing="10" Margin="0,8,0,20">

                            <!-- SOURCE: where the text comes from -->
                            <TextBlock Text="SOURCE" Classes="propSection" />
                            <Border Classes="segment" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                    <ToggleButton Grid.Column="0" Classes="toolbtn-wide" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="The same text on every card" AutomationProperties.Name="Fixed text"
                                                  IsChecked="{Binding SourceType, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Fixed}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mi:MaterialIcon Kind="FormatText" Width="15" Height="15" />
                                            <TextBlock Text="Fixed text" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Grid.Column="1" Classes="toolbtn-wide" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Each card shows its own record's value" AutomationProperties.Name="Database field"
                                                  IsChecked="{Binding SourceType, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Database}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mi:MaterialIcon Kind="DatabaseOutline" Width="15" Height="15" />
                                            <TextBlock Text="Database" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Database: pick the column -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsDatabaseBound}">
                                <TextBlock Text="Field" Classes="caption" />
                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.ActiveTab.DatabaseFields}"
                                          SelectedValue="{Binding DatabaseColumn, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding ColumnName}"
                                          PlaceholderText="Connect a database, then choose a field"
                                          HorizontalAlignment="Stretch" Height="32" CornerRadius="8"
                                          AutomationProperties.Name="Database field">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ColumnName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Turn on Preview in the toolbar to see the selected row's value on the card." />
                            </StackPanel>

                            <!-- Fixed: optionally mix text and fields (replaces the old Prefix/Suffix boxes,
                                 which were not connected to anything) -->
                            <StackPanel Spacing="6" IsVisible="{Binding !IsDatabaseBound}">
                                <TextBlock Text="Text with fields (optional)" Classes="caption" />
                                <TextBox Text="{Binding DataBindingExpression, Mode=TwoWay}" Height="32" CornerRadius="8"
                                         Watermark="e.g. EMP-{{EmployeeID}}"
                                         AutomationProperties.Name="Text with fields" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Put column names in double braces to add prefixes or suffixes, e.g. Dept: {{Department}}. When filled, it replaces the text in the Style tab." />
                            </StackPanel>

                            <!-- PREFIX & SUFFIX: added around the value on every card -->
                            <TextBlock Text="PREFIX &amp; SUFFIX" Classes="propSection" Margin="0,6,0,0" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding Prefix, Mode=TwoWay}" Height="32" CornerRadius="8"
                                         Watermark="e.g. EMP-" ToolTip.Tip="Added before the value" AutomationProperties.Name="Prefix">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="Before" Classes="propPrefix" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="1" Text="{Binding Suffix, Mode=TwoWay}" Height="32" CornerRadius="8"
                                         Watermark="e.g. (Staff)" ToolTip.Tip="Added after the value" AutomationProperties.Name="Suffix">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="After" Classes="propPrefix" />
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                       Text="Example: Before &quot;EMP-&quot; + value 1001 prints EMP-1001. Not shown when the value is empty. Include spaces if you want them." />
                            
                            <!-- FIT -->
                            <TextBlock Text="FIT" Classes="propSection" Margin="0,6,0,0" />
                            <NumericUpDown Classes="prop" Value="{Binding MinFontSize, Mode=TwoWay}"
                                           Minimum="2" Maximum="72" Increment="0.5" FormatString="0.#"
                                           ToolTip.Tip="Long values shrink to fit the box, but never below this size"
                                           AutomationProperties.Name="Smallest font size">
                                <NumericUpDown.InnerLeftContent>
                                    <TextBlock Text="Min size" Classes="propPrefix" />
                                </NumericUpDown.InnerLeftContent>
                            </NumericUpDown>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                       Text="Text that doesn't fit the box shrinks automatically, down to this size." />

                            <!-- SHOW ONLY IF -->
                            <TextBlock Text="SHOW ONLY IF" Classes="propSection" Margin="0,6,0,0" />
                            <TextBox Text="{Binding VisibilityCondition, Mode=TwoWay}" Height="32" CornerRadius="8"
                                     Watermark="e.g. Department == 'Security'"
                                     AutomationProperties.Name="Visibility condition" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                       Text="Leave empty to always show. Checked for each card when printing." />

                        </StackPanel>

                    </ScrollViewer>

                </TabItem>

            </TabControl>

        </DataTemplate>
        <DataTemplate DataType="doc:DateTimeElement">
            <TabControl>

                <!-- ======================= VALUE TAB ======================= -->
                <TabItem Header="Value">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,8,0,20">

                            <!-- Live preview -->
                            <Border Background="{DynamicResource BrushSurfaceElevated}"
                                    CornerRadius="8" Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="PREVIEW" Classes="propSection" />
                                    <TextBlock Text="{Binding PreviewText}"
                                               FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- SHOW -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="SHOW" Classes="propSection" />
                                <Border Classes="segment" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="3">
                                        <ToggleButton Classes="toolbtn" Content="Date + Time" HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding DisplayFormat, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=DateTime}" />
                                        <ToggleButton Classes="toolbtn" Content="Date" HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding DisplayFormat, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Date}" />
                                        <ToggleButton Classes="toolbtn" Content="Time" HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding DisplayFormat, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Time}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- SOURCE -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="SOURCE" Classes="propSection" />
                                <Border Classes="segment" HorizontalAlignment="Stretch">
                                    <UniformGrid Columns="2">
                                        <ToggleButton Classes="toolbtn" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Use the date and time when each card is printed"
                                                      IsChecked="{Binding Source, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=PrintTime}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mi:MaterialIcon Kind="Printer" Width="14" Height="14" />
                                                <TextBlock Text="Print date" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Always print the same chosen date"
                                                      IsChecked="{Binding Source, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Fixed}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mi:MaterialIcon Kind="CalendarEdit" Width="14" Height="14" />
                                                <TextBlock Text="Fixed date" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </UniformGrid>
                                </Border>

                                <!-- Fixed date / time pickers -->
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding IsFixed}">
                                    <CalendarDatePicker Grid.Column="0"
                                                        SelectedDate="{Binding FixedDate, Mode=TwoWay}"
                                                        HorizontalAlignment="Stretch"
                                                        IsVisible="{Binding ShowDateFormat}" />
                                    <TimePicker Grid.Column="2"
                                                SelectedTime="{Binding FixedTime, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" MinWidth="0"
                                                IsVisible="{Binding ShowTimeFormat}" />
                                </Grid>
                            </StackPanel>

                            <!-- FORMAT -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="FORMAT" Classes="propSection" />

                                <ComboBox IsVisible="{Binding ShowDateFormat}"
                                          ItemsSource="{x:Static doc:DateTimeElement.DateFormatPresets}"
                                          Text="{Binding DateFormat, Mode=TwoWay}"
                                          IsEditable="True" HorizontalAlignment="Stretch"
                                          PlaceholderText="Date format, e.g. dd-MM-yyyy"
                                          ToolTip.Tip="dd = day · MM = month · MMM = Jan · yyyy = year. Pick a preset or type your own." />

                                <ComboBox IsVisible="{Binding ShowTimeFormat}"
                                          ItemsSource="{x:Static doc:DateTimeElement.TimeFormatPresets}"
                                          Text="{Binding TimeFormat, Mode=TwoWay}"
                                          IsEditable="True" HorizontalAlignment="Stretch"
                                          PlaceholderText="Time format, e.g. HH:mm"
                                          ToolTip.Tip="HH = 24-hour · hh = 12-hour · mm = minutes · ss = seconds · tt = AM/PM" />
                            </StackPanel>

                            <!-- ADD TO DATE (expiry) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="ADD TO DATE" Classes="propSection"
                                           ToolTip.Tip="For expiry / valid-until dates, e.g. 1 year after the print date" />
                                <Grid ColumnDefinitions="*,6,*,6,*">
                                    <NumericUpDown Grid.Column="0" Classes="prop" ShowButtonSpinner="False"
                                                   Value="{Binding OffsetYears, Mode=TwoWay, Converter={x:Static conv:IntToDecimalConverter.Instance}}"
                                                   Minimum="-100" Maximum="100" Increment="1" FormatString="0">
                                        <NumericUpDown.InnerRightContent>
                                            <TextBlock Text="yrs" Classes="propUnit" />
                                        </NumericUpDown.InnerRightContent>
                                    </NumericUpDown>
                                    <NumericUpDown Grid.Column="2" Classes="prop" ShowButtonSpinner="False"
                                                   Value="{Binding OffsetMonths, Mode=TwoWay, Converter={x:Static conv:IntToDecimalConverter.Instance}}"
                                                   Minimum="-1200" Maximum="1200" Increment="1" FormatString="0">
                                        <NumericUpDown.InnerRightContent>
                                            <TextBlock Text="mo" Classes="propUnit" />
                                        </NumericUpDown.InnerRightContent>
                                    </NumericUpDown>
                                    <NumericUpDown Grid.Column="4" Classes="prop" ShowButtonSpinner="False"
                                                  Value="{Binding OffsetDays, Mode=TwoWay, Converter={x:Static conv:IntToDecimalConverter.Instance}}"
                                                   Minimum="-36500" Maximum="36500" Increment="1" FormatString="0">
                                        <NumericUpDown.InnerRightContent>
                                            <TextBlock Text="days" Classes="propUnit" />
                                        </NumericUpDown.InnerRightContent>
                                    </NumericUpDown>
                                </Grid>
                            </StackPanel>

                            <!-- PREFIX & SUFFIX -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="PREFIX &amp; SUFFIX" Classes="propSection" />
                                <Grid ColumnDefinitions="*,8,*">
                                    <TextBox Grid.Column="0" Text="{Binding Prefix, Mode=TwoWay}"
                                             Watermark="e.g. Valid until: " />
                                    <TextBox Grid.Column="2" Text="{Binding Suffix, Mode=TwoWay}"
                                             Watermark="Suffix" />
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================= STYLE TAB ======================= -->
                <TabItem Header="Style">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,8,0,20">

                            <!-- FONT -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="FONT" Classes="propSection" />

                                <ComboBox ItemsSource="{x:Static services:SystemFontCatalog.FontFamilyNamesWithRecentFirst}"
                                          Text="{Binding FontFamily, Mode=TwoWay}"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{Binding Converter={x:Static conv:StringToFontFamilyConverter.Instance}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid ColumnDefinitions="*,8,*">
                                    <NumericUpDown Grid.Column="0" Classes="prop" ShowButtonSpinner="False"
                                                   Value="{Binding FontSize, Mode=TwoWay}"
                                                   Minimum="4" Maximum="200" Increment="1">
                                        <NumericUpDown.InnerRightContent>
                                            <TextBlock Text="pt" Classes="propUnit" />
                                        </NumericUpDown.InnerRightContent>
                                    </NumericUpDown>
                                    <controls:ColorPickerField Grid.Column="2"
                                                               ColorHex="{Binding ColorHex, Mode=TwoWay}" />
                                </Grid>

                                <Border Classes="segment" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Bold"
                                                      IsChecked="{Binding Bold, Mode=TwoWay}">
                                            <mi:MaterialIcon Kind="FormatBold" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Italic"
                                                      IsChecked="{Binding Italic, Mode=TwoWay}">
                                            <mi:MaterialIcon Kind="FormatItalic" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Underline"
                                                      IsChecked="{Binding Underline, Mode=TwoWay}">
                                            <mi:MaterialIcon Kind="FormatUnderline" Width="16" Height="16" />
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ALIGNMENT (one row: horizontal | vertical) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="ALIGNMENT" Classes="propSection" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="segment">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align left"
                                                          IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Left}">
                                                <mi:MaterialIcon Kind="FormatAlignLeft" Width="16" Height="16" />
                                            </ToggleButton>
                                            <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align center"
                                                          IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Center}">
                                                <mi:MaterialIcon Kind="FormatAlignCenter" Width="16" Height="16" />
                                            </ToggleButton>
                                            <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align right"
                                                          IsChecked="{Binding HorizontalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Right}">
                                                <mi:MaterialIcon Kind="FormatAlignRight" Width="16" Height="16" />
                                            </ToggleButton>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="segment">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align top"
                                                          IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Top}">
                                                <mi:MaterialIcon Kind="FormatVerticalAlignTop" Width="16" Height="16" />
                                            </ToggleButton>
                                            <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align middle"
                                                          IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Middle}">
                                                <mi:MaterialIcon Kind="FormatVerticalAlignCenter" Width="16" Height="16" />
                                            </ToggleButton>
                                            <ToggleButton Classes="toolbtn compact" ToolTip.Tip="Align bottom"
                                                          IsChecked="{Binding VerticalAlignment, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Bottom}">
                                                <mi:MaterialIcon Kind="FormatVerticalAlignBottom" Width="16" Height="16" />
                                            </ToggleButton>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </DataTemplate>

		<!--<DataTemplate DataType="doc:DateTimeElement">
			<StackPanel Spacing="10">

				<TextBlock Text="Date / Time" Classes="caption" />

				--><!-- Format --><!--
				<StackPanel Spacing="4">
					<TextBlock Text="Format" Classes="caption" />

					<StackPanel Orientation="Horizontal" Spacing="4">
						<ToggleButton Classes="toolbtn-wide" Content="Date + Time"
									  IsChecked="{Binding DisplayFormat, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=DateTime}" />
						<ToggleButton Classes="toolbtn-wide" Content="Date"
									  IsChecked="{Binding DisplayFormat, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Date}" />
						<ToggleButton Classes="toolbtn-wide" Content="Time"
									  IsChecked="{Binding DisplayFormat, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Time}" />
					</StackPanel>
				</StackPanel>

				--><!-- Date format: only shown when DisplayFormat is Date or DateTime --><!--
				<StackPanel Spacing="4" IsVisible="{Binding ShowDateFormat}">
