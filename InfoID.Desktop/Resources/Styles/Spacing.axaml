<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Spacing scale. Use as {StaticResource Spacing.MD} for margins/padding, etc. -->
  <sys:Double x:Key="Spacing.XS">4</sys:Double>
  <sys:Double x:Key="Spacing.SM">8</sys:Double>
  <sys:Double x:Key="Spacing.MD">16</sys:Double>
  <sys:Double x:Key="Spacing.LG">24</sys:Double>
  <sys:Double x:Key="Spacing.XL">32</sys:Double>
  <sys:Double x:Key="Spacing.XXL">48</sys:Double>

  <!-- Corner radius scale -->
  <CornerRadius x:Key="Radius.SM">4</CornerRadius>
  <CornerRadius x:Key="Radius.MD">8</CornerRadius>
  <CornerRadius x:Key="Radius.LG">12</CornerRadius>
  <CornerRadius x:Key="Radius.XL">16</CornerRadius>
  <CornerRadius x:Key="Radius.Round">999</CornerRadius>

</ResourceDictionary>
