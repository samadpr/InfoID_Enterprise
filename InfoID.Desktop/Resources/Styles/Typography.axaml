<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Centralized typography scale. Apply via Classes="display|h1|h2|h3|body|caption|label".
    Keeping these as Style selectors (rather than per-property resources) means a
    TextBlock only needs one Classes value instead of five separate bindings.
  -->

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="42" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.bodySecondary">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
  </Style>

</Styles>
