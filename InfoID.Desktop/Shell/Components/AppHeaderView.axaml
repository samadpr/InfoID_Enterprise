<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:InfoID.Desktop.Shell.ViewModels"
             xmlns:components="using:InfoID.Desktop.Shell.Components"
             xmlns:conv="using:InfoID.Desktop.Features.CardDesigner.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="44"
             x:Class="InfoID.Desktop.Shell.Components.AppHeaderView"
             x:DataType="vm:ShellViewModel"
             x:Name="Root">

    <Border Background="{DynamicResource BrushHeaderBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="44">

            <!-- Brand + primary menu -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Classes="ghost" Command="{Binding GoHomeCommand}" Padding="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
						<Image Source="avares://InfoID.Desktop/Assets/Images/InfoID.png" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="InfoID" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Menu VerticalAlignment="Center">
                    <MenuItem Header="File">
                        <MenuItem Header="New Card" Command="{Binding NewCardCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="Open..." Command="{Binding OpenTemplatesCommand}" InputGesture="Ctrl+O"
                                  ToolTip.Tip="InfoID designs live in the local database, not loose files -- this opens the saved-designs list." />
                        <Separator />
                        <MenuItem Header="Save" Command="{Binding ActiveDesigner.ActiveTab.SaveCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  InputGesture="Ctrl+S" />
                        <MenuItem Header="Duplicate as New Design"
                                  Command="{Binding ActiveDesigner.DuplicateActiveTabCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  ToolTip.Tip="Opens an editable copy of the current design under a new name -- InfoID's equivalent of Save As, since the original stays untouched under its own saved record." />
                        <MenuItem Header="Save as New Version"
                                  Command="{Binding ActiveDesigner.ActiveTab.SaveVersionCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  ToolTip.Tip="Saves the current state as a numbered version snapshot you can come back to later, in addition to a normal save." />
                        <MenuItem Header="Version History..."
                                  Command="{Binding ActiveDesigner.ShowVersionHistoryCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Separator IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <MenuItem Header="Import" Command="{Binding ActiveDesigner.ImportDesignCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  ToolTip.Tip="Opens a .infoid design file as a new tab." />
                        <MenuItem Header="Export" Command="{Binding ActiveDesigner.ExportActiveTabCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  ToolTip.Tip="Saves the current tab as a portable .infoid design file." />
                        <MenuItem Header="Print Preview" Command="{Binding ActiveDesigner.ActiveTab.ShowPrintPreviewCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <MenuItem Header="Print..." Command="{Binding ActiveDesigner.ActiveTab.ShowPrintDialogCommand}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  InputGesture="Ctrl+P" />
                        <MenuItem Header="Dashboard" Command="{Binding OpenDashboardCommand}" InputGesture="Ctrl+Shift+D" />
                        <MenuItem Header="Visitors..." Command="{Binding OpenVisitorsCommand}"
                                  ToolTip.Tip="Import visitors and print visitor badges" />
                        <MenuItem Header="Print History..." Command="{Binding OpenPrintHistoryCommand}" />
                        <MenuItem Header="Reports..." Command="{Binding OpenReportsCommand}" />
                        <MenuItem Header="Audit Log..." Command="{Binding OpenAuditLogCommand}" />
                        <MenuItem Header="Backup &amp; Restore..." Command="{Binding OpenBackupCommand}" />
                        <Separator />
                        <MenuItem Header="Recent Cards" IsEnabled="False"
                                  ToolTip.Tip="See the Recent Cards list on the Home screen." />
                        <MenuItem Header="Close Design" Command="{Binding ActiveDesigner.CloseTabCommand}" CommandParameter="{x:Null}"
                                  IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  InputGesture="Ctrl+W" />
                        <Separator />
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </MenuItem>

                    <!-- Edit/View only make sense while a design is actually open (Part 5:
                         "Do NOT show designer-specific menus globally on Home"); every
                         item below maps to a real, already-working command; nothing here
                         is a placeholder (Part 88). Items with no backing implementation
                         yet (Cut, Select All, Lock/Unlock, Show Guides, Panels, Full
                         Screen, ...) are left out entirely rather than wired to nothing. -->
                    <MenuItem Header="Edit" IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <MenuItem Header="Undo" Command="{Binding ActiveDesigner.ActiveTab.UndoCommand}" InputGesture="Ctrl+Z" />
                        <MenuItem Header="Redo" Command="{Binding ActiveDesigner.ActiveTab.RedoCommand}" InputGesture="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Copy" Command="{Binding ActiveDesigner.ActiveTab.CopyCommand}" InputGesture="Ctrl+C" />
                        <MenuItem Header="Paste" Command="{Binding ActiveDesigner.ActiveTab.PasteCommand}" InputGesture="Ctrl+V" />
                        <MenuItem Header="Duplicate" Command="{Binding ActiveDesigner.ActiveTab.DuplicateSelectedCommand}" InputGesture="Ctrl+D" />
                        <MenuItem Header="Delete" Command="{Binding ActiveDesigner.ActiveTab.DeleteSelectedCommand}" InputGesture="Delete" />
                        <Separator />
                        <MenuItem Header="Group" Command="{Binding ActiveDesigner.ActiveTab.GroupCommand}" InputGesture="Ctrl+G" />
                        <MenuItem Header="Ungroup" Command="{Binding ActiveDesigner.ActiveTab.UngroupCommand}" InputGesture="Ctrl+Shift+G" />
                    </MenuItem>
                    <MenuItem Header="View" IsVisible="{Binding ActiveDesigner, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <MenuItem Header="Zoom In" Command="{Binding ActiveDesigner.ActiveTab.ZoomInCommand}" />
                        <MenuItem Header="Zoom Out" Command="{Binding ActiveDesigner.ActiveTab.ZoomOutCommand}" />
                        <MenuItem Header="Actual Size (100%)" Command="{Binding ActiveDesigner.ActiveTab.ZoomResetCommand}" InputGesture="Ctrl+1" />
                        <Separator />
                        <MenuItem Header="Show/Hide Grid" Command="{Binding ActiveDesigner.ActiveTab.ToggleShowGridCommand}" />
                        <MenuItem Header="Snap to Grid" Command="{Binding ActiveDesigner.ActiveTab.ToggleSnapToGridCommand}" />
                        <MenuItem Header="Show/Hide Rulers" Command="{Binding ActiveDesigner.ActiveTab.ToggleShowRulersCommand}" />
                        <Separator />
                        <MenuItem Header="Show/Hide Guides" Command="{Binding ActiveDesigner.ActiveTab.ToggleShowGuidesCommand}" />
                        <MenuItem Header="Snap to Guides" Command="{Binding ActiveDesigner.ActiveTab.ToggleSnapToGuidesCommand}" />
                        <MenuItem Header="Snap to Objects" Command="{Binding ActiveDesigner.ActiveTab.ToggleSnapToObjectsCommand}" />
                        <MenuItem Header="Clear Guides" Command="{Binding ActiveDesigner.ActiveTab.ClearGuidesCommand}" />
                        <Separator />
                        <MenuItem Header="Properties Panel" Command="{Binding ActiveDesigner.ToggleShowPropertiesPanelCommand}" />
                        <MenuItem Header="Layers Panel" Command="{Binding ActiveDesigner.ToggleShowLayersPanelCommand}" />
                    </MenuItem>

                    <!-- Windows (Part 82): lists every open design tab so a user can jump
                         straight to one from anywhere in the app, including from Home,
                         not just while the designer itself is the active page. Bound
                         through ShellViewModel.Designer (the singleton Card Designer
                         instance, always alive; see App.axaml.cs) rather than
                         ActiveDesigner (which is null except while that page is
                         actually shown), and through ActivateDesignTabCommand (which
                         both selects the tab and navigates there) rather than the
                         designer's own SelectTabCommand (which only selects; fine
                         while already on the page, but wouldn't actually switch pages
                         when starting from Home). -->
                    <MenuItem Header="Windows">
                        <MenuItem Header="Full Screen" Command="{Binding ToggleFullScreenCommand}" />
                        <Separator />
                        <MenuItem Header="(No designs open)"
                                  IsVisible="{Binding Designer.Tabs.Count, Converter={x:Static conv:CountToBoolConverter.Instance}, ConverterParameter=Zero}"
                                  IsEnabled="False" />
                        <ItemsControl ItemsSource="{Binding Designer.Tabs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem Header="{Binding Title}"
                                              Command="{Binding #Root.((vm:ShellViewModel)DataContext).ActivateDesignTabCommand}"
                                              CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </MenuItem>

                    <MenuItem Header="Help">
                        <MenuItem Header="Documentation" IsEnabled="False" ToolTip.Tip="Not yet implemented" />
                        <MenuItem Header="Keyboard Shortcuts" IsEnabled="False" ToolTip.Tip="Not yet implemented" />
                        <MenuItem Header="Account and license..." Command="{Binding OpenLicenseCommand}" />
                        <MenuItem Header="Editions..." Command="{Binding OpenEditionsCommand}" />
                        <MenuItem Header="Open log folder" Command="{Binding OpenLogFolderCommand}"
                                  ToolTip.Tip="Folder with InfoID's log files. Send today's file to support when reporting a problem." />
                        <Separator />
                        <MenuItem Header="About InfoID" Command="{Binding ShowAboutCommand}" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!-- Reserved for future contextual page actions (save/print status, etc.) -->
            <ContentControl Grid.Column="1" />

            <!-- Utility area: theme toggle, future notifications/license/account -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center">
                <!-- Dashboard (SRS 4.1): today's cards, expiring cards, license, system health -->
                <Button Classes="ghost" Command="{Binding OpenDashboardCommand}" VerticalAlignment="Center"
                        HotKey="Ctrl+Shift+D" ToolTip.Tip="Dashboard (Ctrl+Shift+D)" AutomationProperties.Name="Dashboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ViewDashboardOutline" Width="16" Height="16" />
                        <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Editions: "Get a license" / "Upgrade" / "Editions" depending on the license -->
                <Button Classes="ghost" Command="{Binding OpenEditionsCommand}" VerticalAlignment="Center"
                        Content="{Binding LicenseBadge.EditionsButtonText}"
                        ToolTip.Tip="Compare the editions and request a plan" />

                <!-- Trial mode (signed in, not activated): cards used of the trial allowance -->
                <Button Classes="ghost" Command="{Binding OpenLicenseCommand}" VerticalAlignment="Center"
                        IsVisible="{Binding Trial.IsTrialMode}" AutomationProperties.Name="Trial cards"
                        ToolTip.Tip="{Binding Trial.TrialUsageText, StringFormat='{}{0}. Printed trial cards carry a watermark. Click to activate InfoID.'}">
                    <Border CornerRadius="10" Padding="8,2" BorderThickness="1" BorderBrush="{DynamicResource BrushWarning}">
                        <TextBlock Text="{Binding Trial.HeaderText}" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                </Button>

                <!-- Signed out: Log in -->
                <Button Classes="secondary" Content="Log in" Command="{Binding AccountLogInCommand}"
                        IsVisible="{Binding !Account.IsSignedIn}" VerticalAlignment="Center"
                        ToolTip.Tip="Log in or create an account (optional -- activation codes work without one)" />

                <!-- Signed in: avatar + first name, menu -->
                <Button Classes="ghost" Padding="4,2" IsVisible="{Binding Account.IsSignedIn}" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding Account.Profile.Email}"
                        AutomationProperties.Name="Account menu">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BrushPrimary}">
                            <TextBlock Text="{Binding AccountInitials}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding AccountFirstName}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Account and license" Command="{Binding OpenLicenseCommand}" />
                            <MenuItem Header="Editions" Command="{Binding OpenEditionsCommand}" />
                            <Separator />
                            <MenuItem Header="Sign out" Command="{Binding AccountSignOutCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <components:ThemeToggleView />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
