<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoID.AdminLicenseManager.ViewModels"
             x:Class="InfoID.AdminLicenseManager.Views.AuditLogView"
             x:DataType="vm:AuditLogViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Verify integrity" Command="{Binding VerifyChainCommand}" />
                    <Button Content="Refresh" Command="{Binding LoadCommand}" />
                </StackPanel>
                <TextBlock Text="Audit Log" Classes="h1" />
            </DockPanel>
            <TextBlock Text="{Binding ChainStatus}" TextWrapping="Wrap"
                       IsVisible="{Binding ChainStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}" x:CompileBindings="False" IsReadOnly="True" AutoGenerateColumns="False"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding When}" />
                <DataGridTextColumn Header="Who" Binding="{Binding Who}" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                <DataGridTextColumn Header="Workstation" Binding="{Binding Workstation}" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
