<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoID.AdminLicenseManager.ViewModels"
             x:Class="InfoID.AdminLicenseManager.Views.PlansView"
             x:DataType="vm:PlansViewModel">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.ColumnSpan="2" Text="Plans" Classes="h1" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="The editions customers can request from the app's Editions page. Inactive plans are hidden from customers." />

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Message}" Margin="0,0,0,8"
                   Classes.error="{Binding MessageIsError}" Classes.success="{Binding !MessageIsError}"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="New plan" Command="{Binding NewCommand}" IsVisible="{Binding CanManage}" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" x:CompileBindings="False"
                      IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order" Binding="{Binding SortOrder}" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Edition" Binding="{Binding Tier}" />
                    <DataGridTextColumn Header="Months" Binding="{Binding DurationMonths}" />
                    <DataGridTextColumn Header="PCs" Binding="{Binding DefaultMachines}" />
                    <DataGridTextColumn Header="Card limit" Binding="{Binding MaxCardsPerPeriod}" />
                    <DataGridTextColumn Header="Price" Binding="{Binding PriceText}" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" />
                    <DataGridTextColumn Header="Tagline" Binding="{Binding Tagline}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Row="3" Grid.Column="1" Width="380" Margin="16,0,0,0" IsVisible="{Binding CanManage}">
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding FormTitle}" Classes="section" />

                    <TextBlock Text="Name" Classes="caption" />
                    <TextBox Text="{Binding Name}" Watermark="e.g. Professional" />

                    <TextBlock Text="Edition (what the license unlocks)" Classes="caption" />
                    <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Tagline" Classes="caption" />
                    <TextBox Text="{Binding Tagline}" Watermark="e.g. Schools and companies. Databases and barcodes." TextWrapping="Wrap" />

                    <TextBlock Text="Features (one per line)" Classes="caption" />
                    <TextBox Text="{Binding FeaturesText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />

                    <CheckBox Content="Perpetual (no expiry)" IsChecked="{Binding Perpetual}" />
                    <StackPanel Spacing="4" IsVisible="{Binding HasDuration}">
                        <TextBlock Text="Duration (months)" Classes="caption" />
                        <NumericUpDown Value="{Binding DurationMonths}" Minimum="1" Maximum="120" Increment="1" FormatString="0" />
                    </StackPanel>

                    <TextBlock Text="Default computers" Classes="caption" />
                    <NumericUpDown Value="{Binding DefaultMachines}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />

                    <CheckBox Content="Unlimited cards" IsChecked="{Binding UnlimitedCards}" />
                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding HasCardLimit}">
                        <NumericUpDown Value="{Binding MaxCardsPerPeriod}" Minimum="100" Maximum="10000000" Increment="100" FormatString="N0" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding LimitPeriods}" SelectedItem="{Binding LimitPeriod}" HorizontalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Text="Price text (display only)" Classes="caption" />
                    <TextBox Text="{Binding PriceText}" Watermark="e.g. Contact sales" />

                    <TextBlock Text="Display order" Classes="caption" />
                    <NumericUpDown Value="{Binding SortOrder}" Minimum="0" Maximum="1000" Increment="1" FormatString="0" />

                    <CheckBox Content="Active (shown to customers)" IsChecked="{Binding IsActive}" />

                    <Button Content="Save plan" Classes="accent" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
