<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoID.AdminLicenseManager.ViewModels"
             xmlns:svc="using:InfoID.Licensing.Server.Services"
             x:Class="InfoID.AdminLicenseManager.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.ColumnSpan="2" Text="Customers" Classes="h1" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" Margin="0,0,0,8"
                   Classes.error="{Binding MessageIsError}" Classes.success="{Binding !MessageIsError}"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

        <!-- Left: search and list -->
        <DockPanel Grid.Row="2" Grid.Column="0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                <TextBox Watermark="Search name, company, email or phone" Text="{Binding SearchText}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="200"
                          ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="Refresh" Command="{Binding SearchCommand}" />
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Totals}" Classes="caption" Margin="0,8,0,0" />

            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" x:CompileBindings="False"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" />
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" />
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" />
                    <DataGridTextColumn Header="Country" Binding="{Binding Country}" />
                    <DataGridTextColumn Header="Signed up" Binding="{Binding CreatedDate, StringFormat={}{0:d}}" />
                    <DataGridTextColumn Header="Requests" Binding="{Binding RequestCount}" />
                    <DataGridTextColumn Header="Licenses" Binding="{Binding LicenseCount}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: details -->
        <ScrollViewer Grid.Row="2" Grid.Column="1" Width="380" Margin="16,0,0,0">
            <StackPanel Spacing="12">
                <Border Classes="card" IsVisible="{Binding !HasSelection}">
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="Select a customer to see their details, requests and licenses." />
                </Border>

                <Border Classes="card" IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="6">
                        <SelectableTextBlock Text="{Binding SelectedRow.FullName}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedSummary}" Classes="caption" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,0">
                            <TextBlock Grid.Row="0" Text="Company" Classes="caption" />
                            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRow.CompanyName}" />
                            <TextBlock Grid.Row="1" Text="Email" Classes="caption" />
                            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRow.Email}" />
                            <TextBlock Grid.Row="2" Text="Phone" Classes="caption" />
                            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.Phone}" />
                            <TextBlock Grid.Row="3" Text="Country" Classes="caption" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRow.Country}" />
                        </Grid>
                        <Button Content="Resend verification email" Margin="0,6,0,0" IsVisible="{Binding CanResend}"
                                Command="{Binding ResendVerificationCommand}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Licenses" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Licenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:AccountLicense">
                                    <StackPanel Margin="0,4">
                                        <SelectableTextBlock Text="{Binding ActivationCode}" FontFamily="Consolas, monospace" />
                                        <TextBlock Classes="caption" TextWrapping="Wrap">
                                            <Run Text="{Binding Tier}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Status}" />
                                            <Run Text="· expires" />
                                            <Run Text="{Binding ExpiryDate}" />
                                            <Run Text="· machines" />
                                            <Run Text="{Binding ActiveMachines}" />
                                            <Run Text="/" />
                                            <Run Text="{Binding MaxActivations}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Requests" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Requests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:AccountRequest">
                                    <StackPanel Margin="0,4">
                                        <TextBlock>
                                            <Run Text="#" /><Run Text="{Binding Id}" />
                                            <Run Text="{Binding PlanName}" FontWeight="SemiBold" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Machines}" />
                                            <Run Text="PC(s)" />
                                        </TextBlock>
                                        <TextBlock Classes="caption" TextWrapping="Wrap">
                                            <Run Text="{Binding Status}" />
                                            <Run Text="{Binding ActivationCode}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding CanDisable}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Disable account" Classes="section" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="The customer can no longer log in and is signed out everywhere. Their licenses keep working; revoke them in Activation Codes if needed." />
                        <TextBox Watermark="Reason (required)" Text="{Binding DisableReason}" />
                        <Button Content="Disable account" HorizontalAlignment="Stretch" Command="{Binding DisableCommand}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding CanEnable}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Account disabled" Classes="section" />
                        <Button Content="Enable account" HorizontalAlignment="Stretch" Command="{Binding EnableCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
