# Normalize line endings to LF in the repository regardless of which OS/editor
# checked a file in with -- Visual Studio and Rider default to different tab/CRLF
# settings, and without this every shared file's line endings drift between
# contributors, making ordinary diffs look like whole-file rewrites and turning
# every merge into a false conflict.
* text=auto eol=lf

*.cs text
*.axaml text
*.xaml text
*.csproj text
*.sln text
*.slnx text
*.json text
*.md text
*.editorconfig text
*.gitattributes text
*.gitignore text

# Binary assets -- never text-normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.onnx binary
*.dll binary
*.pdb binary
